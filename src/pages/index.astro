---
import Layout from "../layouts/Layout.astro";

const whatsapp =
  "https://wa.me/5511988171918?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o";
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Alameda+Graja%C3%BA%2C+60%2C+Alphaville%2C+Barueri%2C+SP";
---

<Layout
  title="Clínica Renata Soares — Em breve"
  description="O novo site da Clínica Renata Soares — Fisioterapia Pediátrica em Alphaville — está em construção. Fale com a clínica pelo WhatsApp."
>
  <main class="soon">
    <div class="soon__card">
      <img
        src="/logo-renata-vertical.svg"
        alt="Clínica Renata Soares — Fisioterapeuta de Crianças e Adolescentes"
        class="soon__logo"
        width="220"
        height="136"
      />

      <p class="soon__eyebrow">Novo site a caminho</p>
      <h1>Estamos em construção</h1>
      <p class="soon__text">
        Estamos preparando um novo espaço online para a Clínica Renata Soares — Fisioterapia
        Pediátrica em Alphaville. Enquanto isso, fale diretamente com a clínica pelo WhatsApp.
      </p>

      <a class="soon__btn" href={whatsapp} target="_blank" rel="noopener">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M16 2.9C8.8 2.9 2.9 8.7 2.9 16c0 2.6.7 5 2 7.1L3 29l6.1-1.9c2 1.1 4.3 1.7 6.9 1.7 7.2 0 13.1-5.8 13.1-13.1S23.2 2.9 16 2.9Zm0 23.8c-2.3 0-4.5-.6-6.4-1.8l-.5-.3-3.6 1.1 1.1-3.5-.3-.5C5.1 19.7 4.5 17.9 4.5 16c0-6.3 5.2-11.5 11.5-11.5S27.5 9.7 27.5 16 21.8 26.7 16 26.7Zm6.3-8.6c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.3-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.7.2-.2.3-.4.5-.6.2-.2.2-.4.1-.7-.1-.3-.8-2-1.1-2.7-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.1 3c.1.2 1.9 2.9 4.6 4 2.7 1.1 2.7.7 3.2.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.5-.3Z"
          />
        </svg>
        Falar no WhatsApp
      </a>

      <p class="soon__phone">+55 11 98817-1918</p>

      <div class="soon__divider" aria-hidden="true"></div>

      <address class="soon__address">
        <a class="soon__address-link" href={mapsUrl} target="_blank" rel="noopener">
          Alameda Grajaú, 60 — Sala 1010, Alphaville, Barueri — SP
        </a>
      </address>
    </div>
  </main>
</Layout>

<style>
  .soon {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    background: radial-gradient(120% 120% at 50% -10%, var(--color-accent) 0%, var(--color-accent-dark) 70%);
  }

  .soon__card {
    width: 100%;
    max-width: 30rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 24px 60px -16px rgb(0 0 0 / 0.4);
  }

  .soon__logo {
    width: clamp(11rem, 9rem + 8vw, 16rem);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .soon__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--font-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .soon__card h1 {
    margin-top: 0.5rem;
    font-size: var(--font-h2);
    color: #fff;
  }

  .soon__text {
    margin-top: 1rem;
    color: rgb(255 255 255 / 0.8);
    line-height: 1.7;
    max-width: 34ch;
  }

  .soon__btn {
    margin-top: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-small);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 10px 26px -6px rgb(37 211 102 / 0.5);
    animation: soon-pulse 2.4s ease-in-out 3;
    transition: transform 0.15s var(--ease-out);
  }

  .soon__btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .soon__btn:hover {
      transform: scale(1.03);
    }
  }

  .soon__btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes soon-pulse {
    0%, 100% {
      box-shadow: 0 10px 26px -6px rgb(37 211 102 / 0.5), 0 0 0 0 rgb(37 211 102 / 0.45);
    }
    50% {
      box-shadow: 0 10px 26px -6px rgb(37 211 102 / 0.5), 0 0 0 10px rgb(37 211 102 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon__btn {
      animation: none;
    }
  }

  .soon__phone {
    margin-top: 0.875rem;
    color: rgb(255 255 255 / 0.6);
    font-size: var(--font-small);
  }

  .soon__divider {
    width: 3rem;
    height: 1px;
    margin-top: 1.75rem;
    background: rgb(255 255 255 / 0.2);
  }

  .soon__address {
    margin-top: 1.25rem;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .soon__address-link {
    color: rgb(255 255 255 / 0.55);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .soon__address-link:hover {
    color: rgb(255 255 255 / 0.85);
    text-decoration: underline;
  }
</style>
